---
# Values for djkormo/adcs-issuer chart on OKD/OpenShift.
# Template - rendered by scripts/deploy-adcs-issuer.sh into rendered/.
#
# OpenShift-specific notes are marked "OpenShift:" below. The two that matter:
#   1. controllerManager.securityContext must NOT pin runAsUser.
#   2. controllerManager.topologySpreadConstraints must be set explicitly,
#      otherwise the chart emits one with a null labelSelector.

crd:
  install: true

# NOTE: `cert-manager:` and `openshift:` blocks used to live here. Neither key
# exists in this chart (2.2.0 or 3.x) - no subchart dependency, and no template
# references them - so Helm silently ignored them. cert-manager is installed
# separately by scripts/deploy-cert-man.sh. Removed to avoid implying they do
# something. In particular `openshift.anyuid: false` was NOT what kept anyuid
# off; the chart never had that switch.

controllerManager:
  manager:
    image:
      repository: djkormo/adcs-issuer  # The repository for the ADCS Issuer Docker image.
      tag: 2.2.1                       # The tag for the ADCS Issuer Docker image.
      imagePullPolicy: IfNotPresent          # The image pull policy.

    resources:
      limits:
        cpu: 100m
        memory: 500Mi
      requests:
        cpu: 100m
        memory: 120Mi

    livenessProbe:
      httpGet:
        path: /healthz
        port: 8081
        scheme: HTTP
      timeoutSeconds: 10
      periodSeconds: 10

    readinessProbe:
      httpGet:
        path: /readyz
        port: 8081 
        scheme: HTTP

      timeoutSeconds: 20
      periodSeconds: 20
      initialDelaySeconds: 10

  rbac:
    enabled: true                        # Enable or disable RBAC.
    serviceAccountName: adcs-issuer      # The name of the service account used by the controller manager.
    certManagerNamespace: cert-manager   # The namespace where cert-manager is installed.
    certManagerServiceAccountName: cert-manager  # The service account name for cert-manager.

  replicas: 1

  kerberosAuthentication:
    enabled: true 

    krb5Config: |
      [libdefaults]
        default_realm = {{ AD_REALM }} 
        dns_lookup_kdc = true

      [realms]
        {{ AD_REALM }} = {
          kdc = {{ AD_DC_HOST }}
        }


      [domain_realm]
        .{{ AD_DOMAIN }} = {{ AD_REALM }}
        {{ AD_DOMAIN }} = {{ AD_REALM }} 

  environment:
    KUBERNETES_CLUSTER_DOMAIN: cluster.local  # Kubernetes cluster domain.
    ENABLE_WEBHOOKS: "false"                  # Enable or disable webhooks.
    ENABLE_DEBUG: "false"                     # Enable or disable debug mode.

  arguments:
    enable-leader-election: "true"            # Enable leader election for high availability.
    cluster-resource-namespace: adcs-issuer   # Namespace for cluster resources.
    zap-log-level: 5                          # Logging level for zap logger.
    disable-approved-check: "false"           # Disable approved check.

  # OpenShift: do NOT set runAsUser here.
  # Each namespace gets its own UID range (see the openshift.io/sa.scc.uid-range
  # annotation, e.g. 1000780000/10000) and the restricted-v2 SCC rejects any UID
  # outside it:
  #     .containers[0].runAsUser: Invalid value: 1000:
  #     must be in the ranges: [1000780000, 1000789999]
  # The Deployment still applies cleanly, so `helm install` reports success - the
  # rejection happens later when the ReplicaSet tries to create pods, leaving the
  # deployment at 0/1 with no pods and ReplicaFailure=True.
  # Omitting runAsUser lets OpenShift assign one from the range. runAsNonRoot and
  # the seccomp profile below satisfy restricted-v2 on their own, so granting the
  # anyuid SCC is unnecessary (the container already drops ALL capabilities and
  # runs with a read-only root filesystem).
  securityContext:
    runAsNonRoot: true
    # `null` here is load-bearing: it DELETES the key. The chart's own values.yaml
    # sets `controllerManager.securityContext.runAsUser: 1000`, and Helm merges this
    # file OVER the chart defaults - so simply omitting runAsUser inherits 1000 and
    # the deployment fails exactly as described above. Only an explicit null removes it.
    runAsUser: null
    seccompProfile:
      type: "RuntimeDefault" 

  # OpenShift: set this explicitly. When it is unset the chart falls back to a
  # hardcoded constraint with NO labelSelector, and the API server warns:
  #     topologySpreadConstraints[0].labelSelector:
  #     a null labelSelector results in matching no pod
  # The chart's default also keys on topology.kubernetes.io/zone, which no node in
  # this cluster carries. kubernetes.io/hostname is a real label, and ScheduleAnyway
  # keeps this advisory so it can never block scheduling on a 3-node compact cluster.
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: "kubernetes.io/hostname"
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          control-plane: controller-manager

  networkPolicy:
    enabled: false

  # These are read from controllerManager.<name>, NOT controllerManager.affinity.<name>.
  # They were previously nested under an `affinity:` key the chart never reads.
  nodeAffinity: {}                          # Node affinity rules for the controller pods.
  podAffinity: {}                           # Pod affinity rules for the controller pods.
  podAntiAffinity: {}                       # Pod anti-affinity rules for the controller pods.

  enabledWebHooks: false                      # Enable or disable webhooks.

  enabledCaCerts: false                       # Enable or disable mounting CA certificates.
  caCertsSecretName: ca-certificates          # Name of the secret containing CA certificates.

metricsService:
  enabled: true                               # Enable or disable the metrics service.
  nameOverride: null                          # Override the name of the metrics service.

  serviceMonitor:
    enabled: true                             # Create a Prometheus ServiceMonitor.
    scheme: http                              # Scheme to use when scraping - http or https

  ports:
  - name: http
    port: 8080
    targetPort: metrics
  type: ClusterIP                             # Type of Kubernetes service.

webhookService:
  ports:
  - port: 443
    targetPort: 9443
  type: ClusterIP                             # Type of Kubernetes service.

nodeSelector: {}

simulator:
  # Turns off the simulator Deployment, Service, Secrets and its ClusterAdcsIssuer.
  enabled: false

  # This one is gated by its OWN key, not simulator.enabled - and the chart
  # defaults it to TRUE. Left alone it renders a Certificate
  # (adcs-sim-certificate) whose issuerRef points at
  # ClusterAdcsIssuer/adcs-sim-adcsclusterissuer, which enabled:false never
  # created. The Certificate then sits READY=False forever while cert-manager
  # retries, minting a fresh temporary private-key Secret
  # (adcs-sim-certificate-<random>) on every attempt.
  exampleCertificate:
    enabled: false

