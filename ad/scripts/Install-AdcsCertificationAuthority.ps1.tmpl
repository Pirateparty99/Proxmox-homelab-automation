<#
.SYNOPSIS
    Installs the AD CS Certification Authority role service and configures an
    Enterprise CA.

.DESCRIPTION
    Run on the intended CA host as a member of Enterprise Admins (an Enterprise
    CA writes its enrollment object into the forest configuration partition, so
    Domain Admins alone is not enough).

    Safe to re-run - if the CA is already configured the script reports it and
    leaves it alone. Reconfiguring an existing CA is deliberately not automated:
    it invalidates every certificate the CA has already issued.

    This installs the CA only. The cert-manager adcs-issuer additionally needs
    the web enrollment pages - see Install-AdcsWebEnrollment.ps1.

.NOTES
    The CA service (CertSvc) runs as LocalSystem on an Enterprise CA and does
    NOT support a gMSA. gMSAs apply to the IIS application pools that front the
    CA - see New-AdcsWebEnrollmentGmsa.ps1 and New-AdcsCesGmsa.ps1.

    SNAPSHOT: -SnapshotFirst (on by default) asks Proxmox to snapshot this VM
    before anything is changed. Taking a snapshot of a running DC is safe.
    ROLLING ONE BACK IS NOT, and is not something this script does.

    Restoring a DC to an earlier point can cause a USN rollback: the restored DC
    reissues update sequence numbers its replication partners have already seen,
    and those partners then silently ignore its later changes. This domain has
    two DCs, so that risk is live.

    Windows Server 2012+ mitigates it with VM-GenerationID - on rollback the
    guest sees a changed generation ID, resets its invocation ID and discards
    its RID pool, so replication stays consistent. Proxmox does expose that
    device (both DC VMs carry a `vmgenid` in their config), so rollback is
    supported rather than merely survivable. It is still a recovery action:
    verify replication with `repadmin /showrepl` and `dcdiag` afterwards.

    The snapshot is crash-consistent unless -IncludeRam is set. Neither DC is
    currently running qemu-guest-agent, so Proxmox cannot quiesce the filesystem
    through VSS. AD's database is journalled and recovers from a crash-consistent
    copy, but installing the guest agent (virtio-win) is worth doing.
#>

# GENERATED by bootstrap.py from ad/scripts/Install-AdcsCertificationAuthority.ps1.tmpl -
# do not edit this copy. Values below come from config.env, baked in at render
# time so this file is self-contained: copy just this one file to the CA host.

[CmdletBinding()]
param(
    [string]$CaName = {{ ADCS_CA_NAME | required("ADCS_CA_NAME") | psquote }},
    [string]$CaHost = {{ ADCS_HOST    | required("ADCS_HOST")    | psquote }},

    [ValidateSet('EnterpriseRootCA', 'EnterpriseSubordinateCA')]
    [string]$CaType = 'EnterpriseRootCA',

    [int]$KeyLength      = 4096,
    [string]$HashAlgorithm = 'SHA256',
    [int]$ValidityYears  = 10,

    # Snapshot this VM through the Proxmox API before changing anything.
    # Pass -SnapshotFirst:$false to skip it (and say why in your change record).
    [bool]$SnapshotFirst = $true,

    [string]$PveHost    = {{ PVE_API_HOST     | required("PVE_API_HOST")     | psquote }},
    [string]$PveNode    = {{ PVE_NODE         | required("PVE_NODE")         | psquote }},
    [int]$PveVmid       = {{ PVE_DC_VMID      | required("PVE_DC_VMID")      }},
    [string]$PveTokenId = {{ PVE_API_TOKEN_ID | required("PVE_API_TOKEN_ID") | psquote }},

    # Including RAM makes a rollback resume rather than cold-boot. Off by
    # default: a cold boot puts the DC through normal startup, which is where
    # the VM-GenerationID check runs.
    [bool]$IncludeRam = $false,

    # Proxmox uses a self-signed certificate unless you have replaced it.
    [bool]$PveSkipCertCheck = $true
)

$ErrorActionPreference = 'Stop'

$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
if (-not ([Security.Principal.WindowsPrincipal]$identity).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator)) {
    throw "Run this from an elevated PowerShell session."
}

# Only a warning: the CA can legitimately live somewhere other than what
# config.env says, and this script is what you would use to move it there.
$shortName = $CaHost.Split('.')[0]
if ($env:COMPUTERNAME -ne $shortName) {
    Write-Warning "This host is $env:COMPUTERNAME but ADCS_HOST is $CaHost. Continuing anyway."
}

# -------------------------------------------------------------------- snapshot

function New-PveSnapshot {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$ApiHost,
        [Parameter(Mandatory)][string]$Node,
        [Parameter(Mandatory)][int]$Vmid,
        [Parameter(Mandatory)][string]$TokenId,
        [Parameter(Mandatory)][string]$TokenSecret,
        [Parameter(Mandatory)][string]$SnapName,
        [string]$Description = '',
        [bool]$IncludeRam = $false,
        [bool]$SkipCertificateCheck = $true,
        [int]$TimeoutSec = 900
    )

    # Windows Server ships PowerShell 5.1, where Invoke-RestMethod has no
    # -SkipCertificateCheck; the validation callback is the 5.1 equivalent.
    # 5.1 also still negotiates TLS 1.0 by default, which Proxmox refuses.
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $extra = @{}
    if ($SkipCertificateCheck) {
        if ($PSVersionTable.PSVersion.Major -ge 6) {
            $extra['SkipCertificateCheck'] = $true
        } else {
            [Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }
        }
    }

    try {
        $base    = "https://${ApiHost}:8006/api2/json"
        $headers = @{ Authorization = "PVEAPIToken=$TokenId=$TokenSecret" }
        $body    = @{ snapname = $SnapName; vmstate = [int]$IncludeRam }
        if ($Description) { $body['description'] = $Description }

        if (-not $PSCmdlet.ShouldProcess("$Node/$Vmid", "Create snapshot '$SnapName'")) {
            return
        }

        Write-Host "Snapshotting $Node/$Vmid as '$SnapName'..."
        $resp = Invoke-RestMethod -Method Post -Headers $headers -Body $body `
                                  -Uri "$base/nodes/$Node/qemu/$Vmid/snapshot" @extra
        $upid = $resp.data

        # Proxmox returns a task id immediately; the snapshot is not taken until
        # that task finishes. Returning here would race the role install against it.
        $encoded  = [uri]::EscapeDataString($upid)
        $deadline = (Get-Date).AddSeconds($TimeoutSec)
        do {
            Start-Sleep -Seconds 3
            $task = Invoke-RestMethod -Method Get -Headers $headers `
                                      -Uri "$base/nodes/$Node/tasks/$encoded/status" @extra
        } while ($task.data.status -eq 'running' -and (Get-Date) -lt $deadline)

        if ($task.data.status -ne 'stopped') {
            throw "Snapshot task did not finish within $TimeoutSec seconds (UPID $upid)."
        }
        if ($task.data.exitstatus -ne 'OK') {
            throw "Snapshot failed: $($task.data.exitstatus) (UPID $upid)."
        }
        Write-Host "Snapshot '$SnapName' complete."
    } finally {
        # Leaving validation disabled would silently affect every later HTTPS
        # call in this session.
        [Net.ServicePointManager]::ServerCertificateValidationCallback = $null
    }
}

if ($SnapshotFirst) {
    # The token secret is never baked into this file - it is a credential, and
    # rendered scripts get copied around. Set PVE_API_TOKEN or type it here.
    $tokenSecret = $env:PVE_API_TOKEN
    if (-not $tokenSecret) {
        $secure = Read-Host -AsSecureString "Proxmox API token secret for $PveTokenId"
        $bstr   = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure)
        try   { $tokenSecret = [Runtime.InteropServices.Marshal]::PtrToStringAuto($bstr) }
        finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr) }
    }
    if (-not $tokenSecret) {
        throw "No Proxmox API token. Set `$env:PVE_API_TOKEN, or re-run with -SnapshotFirst:`$false to proceed without a snapshot."
    }

    New-PveSnapshot -ApiHost $PveHost -Node $PveNode -Vmid $PveVmid `
                    -TokenId $PveTokenId -TokenSecret $tokenSecret `
                    -SnapName ('preadcs-' + (Get-Date -Format 'yyyyMMdd-HHmmss')) `
                    -Description "Before AD CS role install ($CaName)" `
                    -IncludeRam $IncludeRam -SkipCertificateCheck $PveSkipCertCheck

    Remove-Variable tokenSecret
} else {
    Write-Warning "-SnapshotFirst:`$false - proceeding with no rollback point."
}

# ---------------------------------------------------------------- role service

$feature = Get-WindowsFeature -Name ADCS-Cert-Authority
if ($feature.Installed) {
    Write-Host "Role service ADCS-Cert-Authority is already installed."
} else {
    Write-Host "Installing role service ADCS-Cert-Authority..."
    $result = Install-WindowsFeature -Name ADCS-Cert-Authority -IncludeManagementTools
    if ($result.RestartNeeded -eq 'Yes') {
        Write-Warning "A restart is pending. Reboot and re-run this script."
    }
}

Import-Module ADCSDeployment

# ------------------------------------------------------------------ configured?

# The role service being installed does not mean the CA is configured - those are
# two distinct steps, and the Configuration key only appears after the second.
$configKey = 'HKLM:\SYSTEM\CurrentControlSet\Services\CertSvc\Configuration'
if (Test-Path $configKey) {
    $active = (Get-ItemProperty -Path $configKey -Name Active -ErrorAction SilentlyContinue).Active
    Write-Host "A CA is already configured on this host: $active"
    Write-Host "Leaving it alone. To inspect it:  certutil -cainfo"
} else {
    Write-Host "Configuring $CaType '$CaName' ($KeyLength-bit, $HashAlgorithm, $ValidityYears years)..."

    $params = @{
        CAType                    = $CaType
        CACommonName              = $CaName
        KeyLength                 = $KeyLength
        HashAlgorithmName         = $HashAlgorithm
        CryptoProviderName        = 'RSA#Microsoft Software Key Storage Provider'
        Force                     = $true
    }
    # A subordinate CA's lifetime is bounded by its issuer, which sets the validity
    # at signing time; passing these would be rejected.
    if ($CaType -eq 'EnterpriseRootCA') {
        $params.ValidityPeriod      = 'Years'
        $params.ValidityPeriodUnits = $ValidityYears
    }

    Install-AdcsCertificationAuthority @params

    if ($CaType -eq 'EnterpriseSubordinateCA') {
        Write-Warning "Subordinate CA: submit the request in C:\ to the parent CA, then run"
        Write-Warning "  certutil -installcert <issued.cer>  ;  Start-Service CertSvc"
    }
}

Start-Service CertSvc -ErrorAction SilentlyContinue

# ------------------------------------------------------------------- stale objects

# AD keeps one object per CA under Enrollment Services. A CA that was removed
# without cleanup, or a host renamed after the CA was installed, leaves an entry
# whose dNSHostName no longer resolves - clients then try to enrol against a host
# that does not exist. Reporting is enough; deleting one is a forest-wide change
# and belongs in a deliberate hand-run certutil command.
$configNC = [string]([ADSI]'LDAP://RootDSE').configurationNamingContext
$enrollDN = "CN=Enrollment Services,CN=Public Key Services,CN=Services,$configNC"
Write-Host ""
Write-Host "Enrollment Services objects published in AD:"
foreach ($ca in ([ADSI]"LDAP://$enrollDN").Children) {
    $caCn   = $ca.Properties['cn'].Value
    $caHost = $ca.Properties['dNSHostName'].Value
    $resolves = [bool](Resolve-DnsName -Name $caHost -ErrorAction SilentlyContinue)
    $note = if ($resolves) { '' } else { '   <-- does not resolve in DNS' }
    Write-Host ("  {0,-24} {1}{2}" -f $caCn, $caHost, $note)
}

Write-Host ""
Write-Host "CA status:"
certutil -cainfo | Select-String -Pattern 'CA name|CA type|Cert Hash|DNS Name'

Write-Host ""
Write-Host "Next:"
Write-Host "  ad/scripts/New-AdcsWebEnrollmentGmsa.ps1     (on a DC, creates the app pool gMSA)"
Write-Host "  ad/scripts/Install-AdcsWebEnrollment.ps1     (here, publishes /certsrv over HTTPS)"
