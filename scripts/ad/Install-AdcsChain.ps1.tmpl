<#
.SYNOPSIS
    Runs the whole AD CS chain in order: CA role, web-enrollment gMSA, and the
    /certsrv HTTPS endpoint the cert-manager adcs-issuer needs.

.DESCRIPTION
    Run on the CA host from an elevated session, as a member of Enterprise
    Admins. Copy the whole ad/scripts folder across - this calls its siblings
    from $PSScriptRoot and will not run without them.

    In this domain the CA host is also a domain controller, so all three steps
    belong on one machine. The gMSA step normally needs a reboot before the web
    enrollment step (the host has to see its new group membership); this script
    purges the computer's Kerberos tickets instead, and only asks for a reboot
    if that was not enough.

    Every step is idempotent, so re-running after a failure is safe. To pick up
    where it stopped, use -From.

.PARAMETER From
    Step to start at: CA, Gmsa, or WebEnrollment. Earlier steps are skipped.

.PARAMETER SnapshotFirst
    Passed to the CA step. $true (default) snapshots this VM through the
    Proxmox API before anything changes.

.EXAMPLE
    .\Install-AdcsChain.ps1 -WhatIf
    Shows what each step would do, changing nothing.

.EXAMPLE
    .\Install-AdcsChain.ps1 -From WebEnrollment
    Resumes after a reboot, skipping the CA and gMSA steps.

.NOTES
    The workstation half of the deployment is not run from here - it needs oc
    and helm against the OKD cluster. The commands are printed at the end.
#>

# GENERATED by bootstrap.py from ad/scripts/Install-AdcsChain.ps1.tmpl - do not
# edit this copy. Values below come from config.env, baked in at render time.

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    [ValidateSet('CA', 'Gmsa', 'WebEnrollment')]
    [string]$From = 'CA',

    [bool]$SnapshotFirst = $true,

    [string]$CaHost   = {{ ADCS_HOST          | required("ADCS_HOST")          | psquote }},
    [string]$GmsaName = {{ ADCS_WEB_GMSA_NAME | required("ADCS_WEB_GMSA_NAME") | psquote }},
    [string]$AdcsUrl  = {{ ADCS_URL           | required("ADCS_URL")           | psquote }}
)

$ErrorActionPreference = 'Stop'

$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
if (-not ([Security.Principal.WindowsPrincipal]$identity).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator)) {
    throw "Run this from an elevated PowerShell session."
}

# This script assumes the CA and the web enrollment pages live on this machine.
# Split those across hosts and the steps have to be run separately, on each.
$shortName = $CaHost.Split('.')[0]
if ($env:COMPUTERNAME -ne $shortName) {
    throw "This host is $env:COMPUTERNAME but ADCS_HOST is $CaHost. Run this on $shortName, or run the three scripts individually on the right hosts."
}

$order = @('CA', 'Gmsa', 'WebEnrollment')
$steps = [ordered]@{
    CA            = @{ Script = 'Install-AdcsCertificationAuthority.ps1'
                       Args   = @{ SnapshotFirst = $SnapshotFirst }
                       Title  = 'AD CS role and Enterprise CA' }
    Gmsa          = @{ Script = 'New-AdcsWebEnrollmentGmsa.ps1'
                       Args   = @{}
                       Title  = 'gMSA for the /certsrv application pool' }
    WebEnrollment = @{ Script = 'Install-AdcsWebEnrollment.ps1'
                       Args   = @{}
                       Title  = 'Publish /certsrv over HTTPS' }
}

# Fail before doing anything if the folder was copied across incompletely -
# discovering this between steps would leave the CA half-configured.
foreach ($key in $order) {
    $path = Join-Path $PSScriptRoot $steps[$key].Script
    if (-not (Test-Path $path)) {
        throw "Missing $($steps[$key].Script) in $PSScriptRoot. Copy the whole ad/scripts folder, not just this file."
    }
    $steps[$key].Path = $path
}

function Write-Banner {
    param([string]$Text)
    Write-Host ""
    Write-Host ("=" * 72)
    Write-Host "  $Text"
    Write-Host ("=" * 72)
}

$startIndex = $order.IndexOf($From)
$ran = @()

foreach ($key in $order) {
    if ($order.IndexOf($key) -lt $startIndex) {
        Write-Host "Skipping $key (starting at $From)."
        continue
    }

    $step = $steps[$key]
    Write-Banner "$key - $($step.Title)"

    try {
        # Splatting takes @<variable>; @($step.Args) would be an array
        # subexpression and pass the hashtable as a single positional argument.
        $stepArgs = $step.Args
        & $step.Path @stepArgs
    } catch {
        Write-Host ""
        Write-Warning "Step '$key' failed: $($_.Exception.Message)"
        Write-Host "Fix the cause, then resume with:  .\Install-AdcsChain.ps1 -From $key"
        throw
    }
    $ran += $key

    # --- interlude: make the gMSA usable on this host before the next step ---
    if ($key -eq 'Gmsa') {
        Write-Banner "Gmsa - install on this host"

        if ($PSCmdlet.ShouldProcess($env:COMPUTERNAME, "Install gMSA $GmsaName and refresh Kerberos tickets")) {
            Import-Module ActiveDirectory
            Install-ADServiceAccount -Identity $GmsaName

            # The computer only learns it is in the new retrieval group when it
            # gets a fresh TGT. Purging the SYSTEM logon session's tickets forces
            # that without the reboot the standalone script asks for. 0x3e7 is
            # the well-known LUID for the computer account.
            Write-Host "Purging the computer account's Kerberos tickets..."
            & klist.exe purge -li 0x3e7 | Out-Null

            if (-not (Test-ADServiceAccount -Identity $GmsaName -ErrorAction SilentlyContinue)) {
                Write-Warning "Test-ADServiceAccount still fails for $GmsaName."
                Write-Warning "The ticket refresh was not enough - reboot, then resume with:"
                Write-Warning "    .\Install-AdcsChain.ps1 -From WebEnrollment"
                exit 1
            }
            Write-Host "gMSA $GmsaName is usable on this host."
        }
    }
}

# ------------------------------------------------------------------- summary

Write-Banner "Done"
Write-Host "Steps run: $($ran -join ', ')"
Write-Host ""

if (-not $WhatIfPreference) {
    try {
        $resp = Invoke-WebRequest -Uri "$AdcsUrl/" -UseDefaultCredentials -UseBasicParsing -TimeoutSec 20
        Write-Host "$AdcsUrl -> $($resp.StatusCode); the issuer's endpoint is up."
    } catch {
        $code = $_.Exception.Response.StatusCode.value__
        if ($code -eq 401) {
            Write-Host "$AdcsUrl -> 401; endpoint is up and asking for credentials, which is correct."
        } else {
            Write-Warning "$AdcsUrl is not answering as expected: $($_.Exception.Message)"
        }
    }
}

Write-Host ""
Write-Host "Now, from the workstation with oc and helm:"
Write-Host ""
Write-Host "  helm/certificate-manager/scripts/deploy-cert-man.sh"
Write-Host "  helm/certificate-manager/scripts/deploy-adcs-clusterissuer.sh"
Write-Host ""
Write-Host "The second checks $AdcsUrl before it creates anything."
