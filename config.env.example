# Site configuration. Copy to config.env and edit; config.env is gitignored so
# your real domain, hosts and addresses never get committed.
#
#   cp config.env.example config.env
#
# Everything reads this file: bootstrap.py renders the templates from it and
# lib/config.sh exposes it to the shell scripts (PowerShell uses
# ad/lib/Get-RepoConfig.ps1). To get the same variables in your own shell:
#
#   source lib/config.sh
#
# Requires Jinja2:  dnf install python3-jinja2   |   pip install jinja2
#
# Values that can be derived are derived - set AD_DOMAIN and most of the LDAP
# layout follows. Uncomment a derived variable only if your AD differs.

# ------------------------------------------------------------ Active Directory
AD_DOMAIN=example.internal

# Derived from AD_DOMAIN unless set:
#   AD_REALM      EXAMPLE.INTERNAL          (uppercase domain)
#   AD_NETBIOS    EXAMPLE                   (uppercase first label)
#   AD_DOMAIN_DN  DC=example,DC=internal
#AD_REALM=
#AD_NETBIOS=
#AD_DOMAIN_DN=

# OU containing your users, groups and service accounts, relative to the domain
# root. Defaults to OU=<AD_NETBIOS>. Set to "" if they live at the domain root.
#AD_BASE_OU=OU=EXAMPLE

AD_DC_HOST=dc01.example.internal
AD_DC_PORT=636
AD_BIND_USER=ldap.svc

# Derived unless set:
#   AD_BASE_DN        <AD_BASE_OU>,<AD_DOMAIN_DN>
#   AD_GROUP_BASE_DN  OU=Groups,<AD_BASE_DN>
#   AD_BIND_DN        CN=<AD_BIND_USER>,OU=Service Accounts,<AD_BASE_DN>
#AD_BASE_DN=
#AD_GROUP_BASE_DN=
#AD_BIND_DN=

# Root CA certificate in PEM form. Export from the CA with:
#   certutil -ca.cert ca.cer
#   openssl x509 -inform der -in ca.cer -out ad-ca.crt
AD_CA_CERT_FILE=secrets/ad-ca.crt

# --------------------------------------------------------------------- AD CS
ADCS_CA_NAME=Example-CA
ADCS_HOST=dc01.example.internal
ADCS_TEMPLATE=WebServer
ADCS_ISSUER_NAME=example-adcs
ADCS_ENROLL_USER=svc-adcs
ADCS_NAMESPACE=adcs-issuer

# Certificate Enrollment Web Service (CES) gMSA - ad/scripts/New-AdcsCesGmsa.ps1
CES_GMSA_NAME=gmsa-ces
CES_HOST=dc01.example.internal
CES_GROUP_NAME=CES-Hosts

# Scripts run from your workstation. Leave unset to use the ambient
# KUBECONFIG / ~/.kube/config, or point at a specific file.
#KUBECONFIG=~/.kube/okd

# ----------------------------------------------------------------------- OKD
OKD_IDP_NAME=example-ad
OKD_ADMIN_GROUP=okd-admins
OKD_VIEWER_GROUP=okd-users
OKD_ADMIN_ROLE=cluster-admin
OKD_VIEWER_ROLE=cluster-reader

OKD_BASE_DOMAIN=okd.example.internal
OKD_APPS_DOMAIN=apps.okd.example.internal
OKD_API_VIP=10.0.0.51
OKD_INGRESS_VIP=10.0.0.50

# -------------------------------------------------------------- Proxmox / Ceph
# Proxmox node the ceph CLI is run on, over SSH.
PVE_CEPH_HOST=10.0.0.11
CEPH_SSH_USER=root
CEPH_FS_NAME=cephfs
CEPH_RBD_POOL=okd-rbd
# Two-node cluster: size 2 / min_size 1. Use 3/2 with three or more nodes.
CEPH_POOL_SIZE=2
CEPH_POOL_MIN_SIZE=1

# ------------------------------------------------------------- Chart versions
CERT_MANAGER_VERSION=v1.14.3
ADCS_ISSUER_VERSION=2.2.0
KASM_CHART_VERSION=1.1190.6

# ---------------------------------------------------------------------- Kasm
KASM_PUBLIC_ADDR=kasm.apps.example.internal
